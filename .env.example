# Server-only settings. Live imports remain disabled unless explicitly enabled.
# Export these variables into the local dev server process. On Vercel, configure
# project environment variables; do not put secrets in PUBLIC_ or VITE_ variables.
STEAM_IMPORT_ENABLED=false
STEAM_API_KEY=
# Generate a random signing secret of at least 32 characters (e.g. openssl rand -hex 32).
STEAM_IMPORT_SIGNING_SECRET=

# Before enabling deployed live imports, configure and verify the planned WAF rule
# across both /api/steam/* endpoints. No global API budget is enforced statelessly.
