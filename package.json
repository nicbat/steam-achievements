{
  "name": "achievement-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Steam achievement dashboard with browser storage and bounded Steam imports",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepare": "svelte-kit sync",
    "dev:local": "node scripts/dev-local.mjs",
    "test:browser": "node tests/browser/flows.mjs && node tests/browser/recovery.mjs && node tests/browser/profile-denial.mjs && node tests/browser/game-denial.mjs && node tests/browser/no-achievements.mjs && node tests/browser/import-monitor.mjs && node tests/browser/navigation.mjs"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.73.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "layerchart": "^2.9.2",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
